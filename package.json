{
  "name": "zecca",
  "version": "0.1.0",
  "private": true,
  "description": "Zecca — a private payment app on the XRP Ledger",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/web",
    "e2e"
  ],
  "scripts": {
    "dev": "node scripts/dev/dev.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:ledger": "node -r ./scripts/dev/dnsfix.cjs ./node_modules/vitest/vitest.mjs run --project ledger",
    "test:e2e": "npm run test -w @zecca/e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "build": "npm run build -w @zecca/web"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "concurrently": "10.0.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
