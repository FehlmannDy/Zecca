# Zecca environment. Copy to .env (or run scripts/setup-env.ts, which fills it without printing values).
# Generated by scripts/gen-env-example.ts from scripts/lib/env-vars.ts: edit that file, not this one.
# Commented lines show the default the code applies (no value: see its comment); uncomment to change it.
# Uncommented empty lines must be filled.

# --- Modes ---
# mock = in-memory ledger; devnet = real XRPL Devnet
# LEDGER_MODE=mock
# Mock ledger only: delay in ms before a transaction is validated
# MOCK_VALIDATION_DELAY_MS=500
# mock = local key in the browser behind the raw_sign contract; privy = Privy embedded wallet
# SIGNER_MODE=mock
# mock = fixed test identity after 3 s; eudi = public EU reference verifier
# IDENTITY_MODE=mock
# 1 enables the demo-only routes (dev credit, card test purchase, demo shop)
# DEMO_MODE=0
# production turns off the check of every API response against its schema
# NODE_ENV=

# --- Origins and ports ---
# Public origin of the web app (CORS, links)
# WEB_ORIGIN=http://localhost:3100
# Public origin of the API
# API_ORIGIN=http://localhost:8800
# API origin as seen by the browser (built into the web app)
# NEXT_PUBLIC_API_ORIGIN=http://localhost:8800
# Public https base for Lithic and MoonPay webhooks; locally the tunnel URL (scripts/tunnel.ts)
PUBLIC_WEBHOOK_BASE=
# Port the API listens on
# API_PORT=8800
# Port the API listens on when API_PORT is unset (hosting platforms set it)
# PORT=
# Interface the API binds to (0.0.0.0 in a container)
# API_HOST=127.0.0.1
# Port of the local web dev server
# WEB_PORT=3100

# --- Key store (file encrypted with AES-256-GCM, mode 0600, outside git) ---
# Key store file; a relative path is taken from the repository root
# KEYSTORE_PATH=./.data/keystore.enc
# At least 16 characters; scripts/setup-env.ts generates one
KEYSTORE_PASSPHRASE=

# --- Ledger (Devnet ids, SPEC §2.2; change after a Devnet reset) ---
# Confidential MPT issuance id (the dollar token)
# CMPT_ISSUANCE_ID=006C6AA175853178147D8F0D592D9DE3658C836F69985AB9
# Sponsor account (pays every fee and reserve)
# SPONSOR_ADDRESS=rBCtijgiPFRnLxazz8LMqbkP8zBicWhFxT
# Issuer of the confidential token
# ISSUER_ADDRESS=rB5Pc1c7EYx98o4iWfk4Jx96JrCWgqhfZ3
# Pool account every payment goes through
# POOL_ADDRESS=rNwvGErbykbsfcRnmq6fXhqmrrL94WcZSZ
# Devnet websocket URL; unset = the default Devnet node of xrpl-core
# XRPL_DEVNET_URL=

# --- Storage and background jobs (relative paths are taken from the working directory) ---
# API database file; unset = in memory with LEDGER_MODE=mock, ./.data/zecca.sqlite with devnet
# DATABASE_PATH=
# Pool worker database file (devnet)
# POOL_DB_PATH=./.data/pool.sqlite
# How often the pool worker polls the ledger, in ms
# POOL_POLL_MS=15000
# How often the API reconciles pending payments, in ms (0 = off)
# RECONCILE_MS=60000

# --- Privy (login and user keys) ---
# Privy app id (public)
PRIVY_APP_ID=
# Privy app secret (server only)
PRIVY_APP_SECRET=

# --- MoonPay (top-up, sandbox) ---
# MoonPay publishable key (pk_test_...)
MOONPAY_PUBLISHABLE_KEY=
# MoonPay secret key, signs widget URLs (server only)
MOONPAY_SECRET_KEY=
# MoonPay webhook signing key (wk_test_...), separate from the secret key
MOONPAY_WEBHOOK_KEY=
# Multiplier on sandbox top-ups (1 = none); the screen says Sandbox when not 1
# RAMP_SANDBOX_SCALE=1

# --- Lithic (card, sandbox) ---
# Lithic sandbox API key
LITHIC_API_KEY=
# Lithic API base URL
# LITHIC_BASE_URL=https://sandbox.lithic.com

# --- Product settings (integers, minor units: 1 = one cent) ---
# Demo credit given at sign-up
# WELCOME_CREDIT_MINOR=5000
# Zecca commission on merchant payments, basis points
# MERCHANT_FEE_BPS=50
# Cap per transaction once verified
# TX_CAP_MINOR=500000
# Cap per day once verified
# DAILY_CAP_MINOR=1000000
# Balance cap without identity
# TIER0_BALANCE_CAP_MINOR=15000
# Cap per transaction without identity
# TIER0_TX_CAP_MINOR=5000
# Monthly send cap without identity
# TIER0_MONTHLY_SEND_CAP_MINOR=15000
# Zecca spread on metals, basis points
# MARKET_SPREAD_BPS=100
# Zecca share of Earn yield, basis points
# EARN_FEE_BPS=1000
# Zecca margin on the dollar-to-XRP conversion for Earn, basis points
# EARN_SWAP_BPS=30
# How long a payment request (QR, link) stays payable, in seconds
# PAYMENT_REQUEST_TTL_SECONDS=600
# How long a login session lasts, in hours
# SESSION_TTL_HOURS=168
# Prepared transactions (sign-up, send, pay) allowed per user per minute
# PREPARE_RATE_LIMIT_PER_MIN=30

# --- Phase 2 connectors (only read when their feature is on) ---
# Card: test-only override of the Lithic ASA signing secret; leave empty (fetched from Lithic)
# LITHIC_ASA_SECRET=
# Card: where approved card spend settles on Devnet; unset = the key store cardSettlement wallet
# CARD_SETTLEMENT_ADDRESS=
# Card dev server only: treat test users as verified
# CARD_DEV_TIER1=
# Earn: live (Testnet + Coston2) or mock (in-memory, labelled Test position)
# EARN_MODE=
# Earn: fixed XRP price in cents for tests; unset = live feed with fixture fallback
# EARN_PRICE=
# Earn: 0 turns off the background deposit/withdrawal jobs (tests)
# EARN_JOBS=
# Earn mock: delay before the mock vault position appears, in ms
# EARN_MOCK_EXECUTE_MS=
# Market: live (public metals feeds) or fixture
# MARKET_PRICE_SOURCE=
# Market: 1 publishes prices on Devnet with OracleSet and reads them back
# MARKET_ORACLE=
# Identity: an extra public issuer CA (PEM, base64), e.g. for a Paradym test PID
# IDENTITY_EXTRA_CA_B64=

# --- Feature flags (1 = on); each stays off until its end-to-end test is green ---
# Top-up with MoonPay
# FEATURE_RAMP=0
# Withdraw to a bank (MoonPay sell)
# FEATURE_WITHDRAW=0
# Card (Lithic)
# FEATURE_CARD=0
# Earn (Flare, Firelight)
# FEATURE_EARN=0
# Metals market
# FEATURE_MARKET=0
# Identity check (EUDI)
# FEATURE_IDENTITY=0
# Proofs of balance and payment
# FEATURE_PROOFS=0
# Demo shop; unset = follows DEMO_MODE
# FEATURE_DEMO_SHOP=
# Passkey (Face ID) approval; keep off (DECISIONS #7)
# FEATURE_PASSKEY=0
# Google login through Privy (DECISIONS #6)
# FEATURE_GOOGLE_LOGIN=0
