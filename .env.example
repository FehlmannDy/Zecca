# --- XRPL (testnet ONLY; the app refuses to start on anything else) ---
XRPL_URL=wss://s.altnet.rippletest.net:51233
# Platform delegate: signs delegated Payments and pays fees. Written by scripts/setup-testnet.mjs
DELEGATE_SEED=
# Merchant paid by the default terminal + the key that terminal sends in x-terminal-key
MERCHANT_ADDRESS=
TERMINAL_KEY=
# Caps in XRP
MAX_TX_XRP=20
MAX_DAILY_XRP=50
# SQLite file
DB_PATH=data/zecca.db
# --- Google Wallet (optional, phase 4) ---
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_LIVE_UPDATES=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SA_KEY_FILE=secrets/wallet-sa.json
